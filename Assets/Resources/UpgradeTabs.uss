.tabbar {
  flex-direction: row;
  gap: 6px;
  padding: 6px;
  background-color: #1e1e2f; /* couleur de fond pour la barre d’onglets */
  border-radius: 12px;
  border-width: 1px; border-color: rgba(255,255,255,0.08);
}

.tab {
  min-height: 34px;
  padding-left: 12px; padding-right: 12px;
  border-radius: 10px;
  border-width: 1px; border-color: rgba(255,255,255,0.06);
  background-color: rgba(255,255,255,0.02);
  color: #e5e7eb;
}
.tab:hover { translate: 0 -1px; }
.tab:focus { outline: none; box-shadow: 0 0 0 2px rgba(99,102,241,0.35); }

.tab > Label { unity-font-style: bold; }

.tabcontent {
  background-color: #2c2c3a; /* couleur de fond des contenus */
  border-radius: 12px;
  padding: 12px;
}

.tab--active {
  background-color: rgba(99,102,241,0.25); /* couleur de fond pour l’onglet actif */
  border-color: rgba(99,102,241,0.35);
  color: #ffffff;
}
