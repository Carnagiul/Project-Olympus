.hudbar{ display:flex; align-items:center; gap:8px; padding:6px 10px; border-radius:12px; border-width:1px; border-color: rgba(255,255,255,0.08); background-color: rgba(255,255,255,0.04); }
.hudbar__label{ font-size:12px; color:#cbd5e1; }
.hudbar__track{ width:120px; height:8px; border-radius:999px; border-width:1px; border-color: rgba(255,255,255,0.12); }
.hudbar__fill{ height:100%; border-radius:999px; }
.hudbar--hp .hudbar__fill{ background-color:#ef4444; }
.hudbar--mana .hudbar__fill{ background-color:#3b82f6; }
.hudbar--endu .hudbar__fill{ background-color:#10b981; }